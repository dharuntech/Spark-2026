# ─────────────────────────────────────────────────────────────
# Spark'26 — environment configuration
# Copy to `.env` and fill in real values. NEVER commit `.env`.
# ─────────────────────────────────────────────────────────────

# Runtime
NODE_ENV=development
PORT=3000
# Public origin of the app (used for CORS + secure cookies in production)
APP_ORIGIN=http://localhost:3000

# PostgreSQL (single master database — students, events, registrations, attendance)
DATABASE_URL="postgresql://spark26:spark26dev@127.0.0.1:5432/spark26?schema=public"
# Used only by `npm test`
TEST_DATABASE_URL="postgresql://spark26:spark26dev@127.0.0.1:5432/spark26_test?schema=public"

# Sessions / auth
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET="change-me-to-a-long-random-string"
SESSION_TTL_HOURS=12
COOKIE_SECURE=false

# First administrator (created by `npm run db:seed`, or `npm run admin:create`)
ADMIN_NAME="Spark26 Coordinator"
ADMIN_EMAIL="admin@spark26.local"
ADMIN_PASSWORD="ChangeMe_Strong#2026"
ADMIN_ROLE=SUPERADMIN

# Uploads
UPLOAD_DIR=var/uploads
MAX_UPLOAD_MB=5

# Rate limiting (requests per window)
RL_LOGIN_PER_15MIN=10
RL_REGISTER_PER_15MIN=40
RL_VERIFY_PER_MIN=120
